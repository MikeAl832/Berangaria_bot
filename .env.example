# Telegram Bot Token (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# DeepSeek API Key (platform.deepseek.com) — чат, суммаризация, память и поиск
DEEPSEEK_API_KEY=your_deepseek_api_key

# Google Gemini API Key (aistudio.google.com) — видео/аудио и эмбеддинги Qdrant
GEMINI_API_KEY=your_gemini_api_key

# Опционально: OpenRouter API Key (нужен только при chat_provider: "openrouter" в config.yaml)
# OPENROUTER_API_KEY=your_openrouter_api_key

# Опционально: локальный запуск без Docker (embedded Qdrant на диске вместо QDRANT_HOST/PORT)
# QDRANT_PATH=qdrant_local
